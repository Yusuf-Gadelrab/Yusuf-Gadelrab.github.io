{
  "id": "/apps/cut/",
  "name": "Cut — Offline Weight Tracker",
  "short_name": "Cut",
  "description": "A private, offline weight tracker for cutting and body recomposition. Daily weigh-ins, a 7-day trend line, a goal line and streaks, stored on your own device with no account and no server.",
